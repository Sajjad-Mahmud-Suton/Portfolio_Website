{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backup_classic/**"
    ],
    "rewrites": [
      {
        "source": "/classic",
        "destination": "/classic.html"
      },
      {
        "source": "/modern",
        "destination": "/modern.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
